            "index": 0
          }
        ],
        [
          {
            "node": "Format Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Top 5 Repos": {
      "main": [
        [
          {
            "node": "GitHub: Fetch README",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GitHub: Fetch README": {
      "main": [
        [
          {
            "node": "Build Digest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Digest": {
      "main": [
        [
          {
            "node": "Stars > 1000?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Stars > 1000?": {
      "main": [
        [
          {
