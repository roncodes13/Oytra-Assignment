 200
 ]
 },
 {
 "parameters": {
 "jsCode": "return [{ json: { t0: Date.now(), url: 'https://demo.realworld.io' } }];"
 },
 "id": "ec19b0cc-2f57-4c65-ba2f-d981b811ba26",
 "name": "Start Timer",
 "type": "n8n-nodes-base.code",
 "typeVersion": 2,
 "position": [
 220,
 200
 ]
 },
 {
 "parameters": {
 "url": "={{ $json.url }}",
 "options": {
 "timeout": 10000,
 "response": {
 "response": {
 "fullResponse": true,
 "neverError": true,
 "responseFormat": "text"
 }
 }
 }
 },
 "id": "e6a5d97e-e945-4c13-8220-15e437cfb828",
 "name": "HTTP Health Check",
 "type": "n8n-nodes-base.httpRequest",
 "typeVersion": 4.2,
 "position": [
 440,
 200
 ],
 "onError": "continueRegularOutput",
 "retryOnFail": true,
 "maxTries": 3,
 "waitBetweenTries": 3000
 },
 {
 "parameters": {
 "jsCode": "// Combine HTTP result + response time. Works for both success and error-output items.\nconst j = $input.first().json;\nconst t0 =
$('Start Timer').first().json.t0;\nconst ms = Date.now() - t0;\nconst code = Number(j.statusCode ?? (j.error && (j.error.httpCode || j.error.status))
?? 0) || 0;\nconst ok = code === 200;\n\n// keep rolling stats for the daily summary (persists only in active/production runs)\nconst s =
$getWorkflowStaticData('global');\ns.checks = (s.checks || 0) + 1;\ns.failures = (s.failures || 0) + (ok ? 0 : 1);\ns.totalMs = (s.totalMs || 0) +
ms;\ns.maxMs = Math.max(s.maxMs || 0, ms);\n\nconst reason = code === 0 ? 'no response / timeout / DNS error' : `HTTP ${code}`;\nreturn [{ json: { ok,
 code, ms,\n alert: `■ **App DOWN**: ${$('Start Timer').first().json.url}\\nStatus: ${reason}\\nResponse time: ${ms} ms\\nTime: ${new
Date().toISOString()}` } }];"
 },
 "id": "c2c67e5e-04e5-40e6-a8c3-37bc280abc26",
 "name": "Evaluate Result",
 "type": "n8n-nodes-base.code",
 "typeVersion": 2,
 "position": [
 660,
 200
 ]
 },
 {
 "parameters": {
 "conditions": {
 "options": {
 "caseSensitive": true,
 "leftValue": "",
 "typeValidation": "strict"
 },
 "conditions": [
 {
 "id": "c1",
 "leftValue": "={{ $json.ok }}",
 "rightValue": "",
 "operator": {
 "type": "boolean",
 "operation": "false",
 "singleValue": true
 }
 }
 ],
 "combinator": "and"
 },
 "options": {}
 },
 "id": "b1faed7b-476d-4ac3-b973-03d33aba96f3",
