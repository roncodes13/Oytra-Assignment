 "id": "f1c8aef9-0453-4964-b507-2b18e55884f7",
 "name": "Daily 9AM",
 "type": "n8n-nodes-base.scheduleTrigger",
 "typeVersion": 1.2,
 "position": [
 0,
 460
 ]
 },
 {
 "parameters": {
 "jsCode": "// Daily summary from stats collected by the 5-minute checks, then reset.\nconst s = $getWorkflowStaticData('global');\nconst checks =
s.checks || 0;\nconst fails = s.failures || 0;\nconst avg = checks ? Math.round(s.totalMs / checks) : 0;\nconst uptime = checks ? (((checks - fails) /
 checks) * 100).toFixed(2) : 'n/a';\nconst content = `■ **Daily Uptime Summary**\\nChecks: ${checks}\\nFailures: ${fails}\\nUptime: ${uptime}%\\nAvg
response: ${avg} ms\\nSlowest: ${s.maxMs || 0} ms`;\ns.checks = 0; s.failures = 0; s.totalMs = 0; s.maxMs = 0;\nreturn [{ json: { content } }];"
 },
 "id": "2212fd05-dc07-4534-abf2-1864b25264a1",
